{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "WriteToFile": true,
    "FilePath": "logs/gateway-.log",
    "Batching": {
      "Enabled": true,
      "BatchSizeLimit": 50,
      "PeriodSeconds": 3,
      "QueueLimit": 10000,
      "SaveBatchSnapshots": true,
      "BatchDirectory": "logs/batches",
      "RemoteEndpoint": "http://localhost:8004"
    }
  },
  "Jwt": {
    "Issuer": "http://localhost:8001",
    "Audience": "shoppingcart-api",
    "Authority": "http://localhost:8001",
    "Signature": "<REPLACE_WITH_DEV_JWT_SIGNING_KEY_MIN_32_CHARS>",
    "ExpirationInMinutes": 120,
    "RequireHttpsMetadata": false
  },
  "Gateway": {
    "RedisFailOpenInDevelopment": true,
    "AllowClientModeOverrideInDevelopment": true,
    "AllowAnonymousMockAuthInDevelopment": true,
    "AllowMockTokenAuth": true,
    "AuthMode": "Enforce",
    "HealthProber": {
      "IntervalSeconds": 60,
      "TimeoutSeconds": 30,
      "FailureThreshold": 5,
      "StartPeriodSeconds": 60,
      "AutoRecoverContainer": true,
      "MaxAutoRecoverAttempts": 3,
      "LogDirectory": "logs/health",
      "MaxLinesPerLogFile": 1000,
      "ApiKey": "<REPLACE_WITH_DEV_CHECKHEAL_API_KEY>"
    },
    "Services": {
      "users": {
        "Mode": "Mock",
        "Address": "http://localhost:8001",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "catalog": {
        "Mode": "Mock",
        "Address": "http://localhost:8002",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "commerce": {
        "Mode": "Mock",
        "Address": "http://localhost:8003",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "log": {
        "Mode": "Mock",
        "Address": "http://localhost:8004",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "auction": {
        "Mode": "Mock",
        "Address": "http://localhost:8005",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "fulfillment": {
        "Mode": "Mock",
        "Address": "http://localhost:8006",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "notification": {
        "Mode": "Mock",
        "Address": "http://localhost:8007",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "wallet": {
        "Mode": "Mock",
        "Address": "http://localhost:8008",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "healthcheck": {
        "Mode": "Mock",
        "Address": "http://localhost:8009",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      }
    }
  }
}
