{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "WriteToFile": true,
    "FilePath": "logs/gateway-.log",
    "Batching": {
      "Enabled": true,
      "BatchSizeLimit": 50,
      "PeriodSeconds": 3,
      "QueueLimit": 10000,
      "SaveBatchSnapshots": false,
      "BatchDirectory": "logs/batches",
      "RemoteEndpoint": "http://localhost:8004"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:8001",
    "Audience": "shoppingcart-api",
    "Authority": "http://localhost:8001",
    "Signature": "<REPLACE_WITH_JWT_SIGNING_KEY_MIN_32_CHARS>",
    "ExpirationInMinutes": 60,
    "RequireHttpsMetadata": false
  },
  "Gateway": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "ConcurrencyLimit": 100,
    "RateLimits": {
      "default": {
        "PermitLimit": 100,
        "WindowSeconds": 60
      },
      "auth-strict": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      },
      "auth-login": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "user-frequent": {
        "PermitLimit": 120,
        "WindowSeconds": 60
      }
    },
    "RedisConnectionString": "localhost:6379",
    "RedisKeyPrefix": "nexus:gateway",
    "RedisFailOpenInDevelopment": false,
    "CorsOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173"
    ],
    "CorsMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "CorsHeaders": [
      "*"
    ],
    "CorsAllowCredentials": true,
    "AllowClientModeOverrideInDevelopment": false,
    "AllowAnonymousMockAuthInDevelopment": false,
    "AllowMockTokenAuth": false,
    "DefaultMockUserId": "11111111-1111-1111-1111-000000000004",
    "DefaultMockRole": "buyer",
    "AuthMode": "Enforce",
    "HealthProber": {
      "IntervalSeconds": 60,
      "TimeoutSeconds": 30,
      "FailureThreshold": 5,
      "StartPeriodSeconds": 60,
      "AutoRecoverContainer": true,
      "MaxAutoRecoverAttempts": 3,
      "LogDirectory": "logs/health",
      "MaxLinesPerLogFile": 1000,
      "ApiKey": "<REPLACE_WITH_CHECKHEAL_API_KEY>"
    },
    "Services": {
      "users": {
        "Mode": "Real",
        "Address": "http://localhost:8001",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "catalog": {
        "Mode": "Real",
        "Address": "http://localhost:8002",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "commerce": {
        "Mode": "Real",
        "Address": "http://localhost:8003",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "log": {
        "Mode": "Real",
        "Address": "http://localhost:8004",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "auction": {
        "Mode": "Real",
        "Address": "http://localhost:8005",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "fulfillment": {
        "Mode": "Real",
        "Address": "http://localhost:8006",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "notification": {
        "Mode": "Real",
        "Address": "http://localhost:8007",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "wallet": {
        "Mode": "Real",
        "Address": "http://localhost:8008",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      }
    }
  }
}
