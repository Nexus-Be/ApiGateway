{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:8001",
    "Audience": "shoppingcart-api",
    "Authority": "http://localhost:8001",
    "Signature": "your-production-jwt-signature-secret-key-min-32-chars-long-123456",
    "ExpirationInMinutes": 60,
    "RequireHttpsMetadata": false
  },
  "Gateway": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "ConcurrencyLimit": 100,
    "RedisConnectionString": "localhost:6379",
    "RedisKeyPrefix": "nexus:gateway",
    "RedisFailOpenInDevelopment": false,
    "CorsOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173"
    ],
    "CorsMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "CorsHeaders": [
      "*"
    ],
    "CorsAllowCredentials": true,
    "AllowClientModeOverrideInDevelopment": false,
    "AllowAnonymousMockAuthInDevelopment": false,
    "AllowMockTokenAuth": false,
    "DefaultMockUserId": "11111111-1111-1111-1111-000000000004",
    "DefaultMockRole": "buyer",
    "AuthMode": "Enforce",
    "Services": {
      "users": {
        "Mode": "Real",
        "Address": "http://localhost:8001",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "catalog": {
        "Mode": "Real",
        "Address": "http://localhost:8002",
        "TimeoutSeconds": 5,
        "MockDelayMs": 0,
        "MockStatus": 200
      },
      "commerce": {
