{
  "id": "auth-resend-otp",
  "service": "users",
  "method": "POST",
  "path": "/api/v1/auth/otp/resend",
  "description": "Resend verification OTP code to user email address",
  "policy": "public",
  "statusCode": 200,
  "responseType": "single",
  "message": "Verification code has been resent to your email.",
  "request": {
    "email": "user@mcs.local"
  },
  "response": {
    "email": "user@mcs.local",
    "resendCooldown": 60
  }
}
