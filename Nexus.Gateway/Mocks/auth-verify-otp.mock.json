{
  "id": "auth-verify-otp",
  "service": "users",
  "method": "POST",
  "path": "/api/v1/auth/verify-otp",
  "description": "Verify user account using email and OTP code",
  "policy": "public",
  "statusCode": 200,
  "responseType": "single",
  "message": "Account verified successfully.",
  "request": {
    "email": "john.doe@example.com",
    "otp": "123456"
  },
  "response": {
    "id": "11111111-1111-1111-1111-000000000099",
    "displayName": "John Doe",
    "email": "john.doe@example.com",
    "roles": [
      "buyer"
    ],
    "status": "Active",
    "shopName": ""
  }
}
