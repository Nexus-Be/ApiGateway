{
  "id": "auth-verify-otp",
  "service": "users",
  "method": "POST",
  "path": "/api/v1/auth/otp/verify",
  "description": "Verify user account using email and OTP code",
  "policy": "public",
  "statusCode": 200,
  "responseType": "single",
  "message": "Account verified successfully.",
  "request": {
    "email": "john.doe@example.com",
    "otp": "123456"
  },
  "response": {
    "isVerified": true,
    "email": "john.doe@example.com"
  }
}
