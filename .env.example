# =============================================================================
# .env.example — Mẫu biến môi trường cho Nexus API Gateway (.NET 8)
# -----------------------------------------------------------------------------
# Cách dùng:
#   cp .env.example .env       # (hoặc Copy-Item .env.example .env trên PowerShell)
#   # Điền giá trị thật / bí mật vào file .env
#
# Lưu ý:
#   - File `.env` ĐÃ ĐƯỢC .gitignore chặn, KHÔNG BAO GIỜ commit lên Git.
#   - File `.env.example` này ĐƯỢC commit lên GitHub làm tài liệu mẫu cho team.
#   - Không đặt secret/key thật vào file này.
# =============================================================================

# --- ASP.NET Core Runtime ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8000

# --- JWT Authentication ---
Jwt__Issuer=http://localhost:8001
Jwt__Authority=http://localhost:8001
Jwt__Audience=shoppingcart-api
Jwt__Signature=<REPLACE_WITH_JWT_SIGNING_KEY_MIN_32_CHARS>
Jwt__ExpirationInMinutes=60
Jwt__RequireHttpsMetadata=false

# --- Gateway Auth Mode (Enforce: yêu cầu JWT/RBAC | Bypass: bỏ qua auth cho Mock) ---
Gateway__AuthMode=Enforce

# --- Redis Rate Limiting ---
Gateway__RedisConnectionString=localhost:6379
Gateway__RedisKeyPrefix=nexus:gateway
Gateway__RedisFailOpenInDevelopment=true
Gateway__PermitLimit=100
Gateway__WindowSeconds=60
Gateway__ConcurrencyLimit=100

# --- CORS Allowed Origins ---
Gateway__CorsOrigins__0=http://localhost:3000
Gateway__CorsOrigins__1=http://localhost:3001
Gateway__CorsOrigins__2=http://localhost:5173

# --- 8 Upstream Microservices gRPC Addresses (Port 8001 - 8008) ---
# Users Service (Port 8001)
Gateway__Services__users__Address=http://localhost:8001
Gateway__Services__users__Mode=Mock

# Catalog Service (Port 8002)
Gateway__Services__catalog__Address=http://localhost:8002
Gateway__Services__catalog__Mode=Mock

# Commerce Service (Port 8003)
Gateway__Services__commerce__Address=http://localhost:8003
Gateway__Services__commerce__Mode=Mock

# Audit Service (Port 8004)
Gateway__Services__audit__Address=http://localhost:8004
Gateway__Services__audit__Mode=Mock

# Auction Service (Port 8005)
Gateway__Services__auction__Address=http://localhost:8005
Gateway__Services__auction__Mode=Mock

# Fulfillment Service (Port 8006)
Gateway__Services__fulfillment__Address=http://localhost:8006
Gateway__Services__fulfillment__Mode=Mock

# Notification Service (Port 8007)
Gateway__Services__notification__Address=http://localhost:8007
Gateway__Services__notification__Mode=Mock

# Wallet Service (Port 8008)
Gateway__Services__wallet__Address=http://localhost:8008
Gateway__Services__wallet__Mode=Mock
