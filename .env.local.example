# =============================================================================
# NEXUS API GATEWAY - LOCAL ENVIRONMENT CONFIGURATION (.env.local.example)
# =============================================================================
# Sử dụng khi chạy ApiGateway trực tiếp trên máy chủ dev (Local Host)

# --- ASP.NET Core Runtime ---
ASPNETCORE_ENVIRONMENT=Development
GATEWAY_PORT=8080

# --- Chế Độ Phân Quyền (Auth Mode: Enforce / Bypass) ---
GATEWAY_AUTH_MODE=Enforce

# --- Hạ Tầng Kết Nối (Localhost) ---
REDIS_CONNECTION_STRING=localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Upstream Services URLs (Localhost Ports 8001 - 8009) ---
USERS_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002
COMMERCE_SERVICE_URL=http://localhost:8003
LOG_SERVICE_URL=http://localhost:8004
AUCTION_SERVICE_URL=http://localhost:8005
FULFILLMENT_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
WALLET_SERVICE_URL=http://localhost:8008
HEALTHCHECK_SERVICE_URL=http://localhost:8009

# --- HealthProber & CheckHeal API Key ---
CHECKHEAL_API_KEY=<REPLACE_WITH_CHECKHEAL_API_KEY>

# --- JWT Authentication Settings ---
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=<REPLACE_WITH_JWT_SIGNING_KEY_MIN_32_CHARS>
JWT_EXPIRATION_IN_MINUTES=60
